# ==============================================================================
# LEDGER AI — Environment Configuration Template
# Copy this file to '.env' and populate variables as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SEC EDGAR Compliance Configuration (No API Key Required)
# The SEC EDGAR system is a free, public service provided by the US Government.
# The SEC Fair Access Policy requires declaring a custom User-Agent in the format:
#   "SampleCompany AdminContact@domain.com"
# Missing or generic user-agents (like 'python-requests') receive HTTP 403.
# ------------------------------------------------------------------------------
SEC_EDGAR_USER_AGENT=LedgerAI/1.0 (compliance@ledgerai.local)
SEC_RATE_LIMIT_DELAY=0.15
EDGAR_CACHE_DIR=.cache/edgar

# ------------------------------------------------------------------------------
# 2. Generative LLM Provider (Optional)
# Ledger AI executes table parsing, hybrid retrieval, and math verification
# completely offline and deterministically without an LLM.
# If an OpenAI key is provided, it can be used for optional conversational
# synthesis over verified tabular context.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
LEDGER_HOST=127.0.0.1
LEDGER_PORT=8000
LEDGER_LOG_LEVEL=info
